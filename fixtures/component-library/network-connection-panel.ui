<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>NetworkConnectionPanel</class>
 <widget class="QFrame" name="networkConnectionPanel">
  <layout class="QFormLayout" name="connectionFormLayout">
   <item row="0" column="0"><widget class="QLabel" name="hostLabel"><property name="text"><string>服务器</string></property><property name="buddy"><cstring>hostLineEdit</cstring></property></widget></item>
   <item row="0" column="1"><widget class="QLineEdit" name="hostLineEdit"/></item>
   <item row="1" column="1"><widget class="QPushButton" name="testConnectionButton"><property name="text"><string>测试连接</string></property></widget></item>
  </layout>
 </widget>
 <tabstops><tabstop>hostLineEdit</tabstop><tabstop>testConnectionButton</tabstop></tabstops>
 <resources><include location="network-icons.qrc"/></resources>
 <connections><connection><sender>testConnectionButton</sender><signal>clicked()</signal><receiver>networkConnectionPanel</receiver><slot>testConnection()</slot></connection></connections>
</ui>
